{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "conf-armgcc-default",
            "binaryDir": "${sourceDir}/_build/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/tools/cmake/armgcc-toolchain.cmake"
            },
            "hidden": true
        },
        {
            "name": "conf-build-gen1",
            "inherits": "conf-armgcc-default",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "REAR_LIGHT_BOARD_VARIANT": "gen1-tld2xxx"
            }
        },
        {
            "name": "conf-build-gen1b-tld509x",
            "inherits": "conf-armgcc-default",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "REAR_LIGHT_BOARD_VARIANT": "gen1b-tld509x"
            }
        },
        {
            "name": "conf-build-gen1b-ild8150",
            "inherits": "conf-armgcc-default",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "REAR_LIGHT_BOARD_VARIANT": "gen1b-ild8150"
            }
        },
        {
            "name": "conf-build-gen2",
            "inherits": "conf-armgcc-default",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "REAR_LIGHT_BOARD_VARIANT": "gen2-al8891"
            }
        },
        {
            "name": "conf-gcc-default",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/_build/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/tools/cmake/gcc-toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "REAR_LIGHT_BUILD_UNITTESTS": "OFF",
                "REAR_LIGHT_BUILD_SILTESTS": "ON",
                "REAR_LIGHT_BUILD_FUNCTESTS": "OFF",
                "REAR_LIGHT_BUILD_DOCS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-app-targets",
            "targets": [
                "application-full"
        ],
            "hidden": true
        },
        {
            "name": "build-cov-targets",
            "hidden": true,
            "targets": [
                "coverage_report"
            ]
        },
        {
            "name": "build-sil-targets",
            "targets": [ "rear-light-server" ],
            "hidden": true
        },
        {
            "name": "build-docs-targets",
            "targets": [ "Sphinx" ],
            "hidden": true
        },
        {
            "name": "build-app-gen1",
            "inherits": "build-app-targets",
            "configurePreset": "conf-build-gen1"
        },
        {
            "name": "build-app-gen1b-tld509x",
            "inherits": "build-app-targets",
            "configurePreset": "conf-build-gen1b-tld509x"
        },
        {
            "name": "build-app-gen1b-ild8150",
            "inherits": "build-app-targets",
            "configurePreset": "conf-build-gen1b-ild8150"
        },
        {
            "name": "build-app-gen2",
            "inherits": "build-app-targets",
            "configurePreset": "conf-build-gen2"
        },
        {
            "name": "build-cov-gcc",
            "inherits": "build-cov-targets",
            "configurePreset": "conf-gcc-default"
        },
        {
            "name": "build-sil-gcc",
            "inherits": "build-sil-targets",
            "configurePreset": "conf-gcc-default"
        },
        {
            "name": "build-docs-gcc",
            "inherits": "build-docs-targets",
            "configurePreset": "conf-gcc-default"
        }
    ],
    "testPresets": [
    ],
    "workflowPresets": [
        {
            "name": "workflow-build-gen1",
            "steps": [
                {
                    "type": "configure",
                    "name": "conf-build-gen1"
                },
                {
                    "type": "build",
                    "name": "build-app-gen1"
                }
            ]
        },
        {
            "name": "workflow-docs",
            "steps": [
                {
                    "type": "configure",
                    "name": "conf-gcc-default"
                },
                {
                    "type": "build",
                    "name": "build-docs-gcc"
                }
            ]
        }
    ]
}